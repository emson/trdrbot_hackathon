# Copy to .env and fill in. Never commit .env.

# Alpaca paper trading credentials.
# NOTE: the MCP server (v2) uses these names, NOT the APCA_* names used by the
# REST SDK. Getting this wrong is a silent auth failure.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true

# LLM gateway. Provider-agnostic by design (D-008) - swap the model in
# config.yaml, not here.
ANTHROPIC_API_KEY=


OPENAI_API_KEY=

# OpenCode Zen (config-level "opencode_zen" provider, config.yaml llm.providers)
# - an OpenAI-compatible gateway serving GLM-5.2 at its own base_url.
# Get a key at https://opencode.ai/auth. Kept separate from OPENAI_API_KEY:
# they hit different endpoints and the real OPENAI_API_KEY must still work
# for the openai:gpt-5* fallback entries in config.yaml.
ZEN_API_KEY=

